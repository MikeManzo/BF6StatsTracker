name: Release

# This workflow is triggered when you push a version tag
# Example: git tag v1.0.1 && git push origin v1.0.1

on:
  push:
    tags:
      - 'v*'

jobs:
  build-and-release:
    runs-on: macos-14

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Xcode
      uses: maxim-lobanov/setup-xcode@v1
      with:
        xcode-version: latest-stable

    # Import your Developer ID certificate for code signing
    - name: Import Code Signing Certificates
      env:
        CERTIFICATES_P12: ${{ secrets.CERTIFICATES_P12 }}
        CERTIFICATES_PASSWORD: ${{ secrets.CERTIFICATES_PASSWORD }}
      run: |
        echo "$CERTIFICATES_P12" | base64 --decode > certificate.p12
        security create-keychain -p actions temp.keychain
        security default-keychain -s temp.keychain
        security unlock-keychain -p actions temp.keychain
        security import certificate.p12 -k temp.keychain -P "$CERTIFICATES_PASSWORD" -T /usr/bin/codesign
        security set-key-partition-list -S apple-tool:,apple: -s -k actions temp.keychain

    # Build and archive the app
    - name: Build and Archive
      run: |
        xcodebuild -scheme BF6StatsTracker \
          -configuration Release \
          -archivePath ./build/BF6StatsTracker.xcarchive \
          archive

    # Export the archive
    - name: Export Archive
      run: |
        xcodebuild -exportArchive \
          -archivePath ./build/BF6StatsTracker.xcarchive \
          -exportPath ./build \
          -exportOptionsPlist ExportOptions.plist

    # Notarize with Apple
    - name: Notarize App
      env:
        APPLE_ID: ${{ secrets.APPLE_ID }}
        APPLE_ID_PASSWORD: ${{ secrets.APPLE_ID_PASSWORD }}
        TEAM_ID: ${{ secrets.TEAM_ID }}
      run: |
        # Create a zip for notarization
        ditto -c -k --keepParent ./build/BF6StatsTracker.app BF6StatsTracker.zip

        # Submit for notarization
        xcrun notarytool submit BF6StatsTracker.zip \
          --apple-id "$APPLE_ID" \
          --password "$APPLE_ID_PASSWORD" \
          --team-id "$TEAM_ID" \
          --wait

        # Staple the notarization
        xcrun stapler staple ./build/BF6StatsTracker.app

    # Create DMG
    - name: Create DMG
      run: |
        brew install create-dmg

        create-dmg \
          --volname "BF6 Stats Tracker" \
          --volicon "BF6StatsTracker/Assets.xcassets/AppIcon.appiconset/icon_512x512.png" \
          --window-pos 200 120 \
          --window-size 800 400 \
          --icon-size 100 \
          --icon "BF6StatsTracker.app" 200 190 \
          --hide-extension "BF6StatsTracker.app" \
          --app-drop-link 600 185 \
          "BF6StatsTracker-${{ github.ref_name }}.dmg" \
          "./build/BF6StatsTracker.app"

    # Download Sparkle tools and generate appcast
    - name: Generate Appcast
      env:
        SPARKLE_PRIVATE_KEY: ${{ secrets.SPARKLE_PRIVATE_KEY }}
      run: |
        # Download Sparkle generate_appcast tool
        curl -L -o generate_appcast.tar.xz \
          https://github.com/sparkle-project/Sparkle/releases/download/2.8.1/Sparkle-2.8.1.tar.xz
        tar -xf generate_appcast.tar.xz

        # Create releases directory if it doesn't exist
        mkdir -p releases

        # Copy DMG to releases directory
        cp "BF6StatsTracker-${{ github.ref_name }}.dmg" releases/

        # Generate appcast
        ./bin/generate_appcast releases/

        # Move appcast to root
        cp releases/appcast.xml ./appcast.xml

        # Commit updated appcast back to repo
        git config user.name github-actions
        git config user.email github-actions@github.com
        git add appcast.xml
        git commit -m "Update appcast for ${{ github.ref_name }}" || echo "No changes to commit"
        git push || echo "Nothing to push"

    # Create GitHub Release
    - name: Create GitHub Release
      uses: softprops/action-gh-release@v1
      with:
        files: BF6StatsTracker-${{ github.ref_name }}.dmg
        generate_release_notes: true
        draft: false
        prerelease: false
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

# Required GitHub Secrets:
# - CERTIFICATES_P12: Base64-encoded .p12 file with your Developer ID certificate
# - CERTIFICATES_PASSWORD: Password for the .p12 file
# - APPLE_ID: Your Apple ID email
# - APPLE_ID_PASSWORD: App-specific password from appleid.apple.com
# - TEAM_ID: Your Apple Developer Team ID
# - SPARKLE_PRIVATE_KEY: Your EdDSA private key from generate_keys
#
# To create CERTIFICATES_P12:
# 1. Export your Developer ID certificate from Keychain as .p12
# 2. Convert to base64: base64 -i certificate.p12 | pbcopy
# 3. Paste as GitHub secret
